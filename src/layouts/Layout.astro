---
import '../styles/global.css';
import Navbar from '@/components/Navbar';
import SideRail from '@/components/SideRail';
import ForgeFX from '@/components/ForgeFX';
import IntensityToggle from '@/components/IntensityToggle';
const { title = 'Strange Stone Works' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;800&family=Rajdhani:wght@400;600;700&family=Inter:wght@400;500;700&family=JetBrains+Mono:wght@400;700&display=swap" />
  </head>
  <body>
    <ForgeFX client:visible />
    <SideRail />
    <main class="max-w-6xl mx-auto px-4 pb-16">
      <Navbar client:load />
      <div class="flex justify-end py-3"><IntensityToggle client:load /></div>
      <slot />
    </main>
  </body>
</html>
