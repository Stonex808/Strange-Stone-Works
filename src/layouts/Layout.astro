---
import '../styles/global.css';
import Navbar from '@/components/Navbar';
import SideRail from '@/components/SideRail';
import ForgeFX from '@/components/ForgeFX';
import IntensityToggle from '@/components/IntensityToggle';
const { title = 'Strange Stone Works' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="referrer" content="strict-origin-when-cross-origin" />
  </head>
  <body>
    <ForgeFX client:visible />
    <SideRail />
    <main class="max-w-6xl mx-auto px-4 pb-16">
      <Navbar client:load />
      <div class="flex justify-end py-3"><IntensityToggle client:load /></div>
      <slot />
    </main>
  </body>
</html>
